# Copy this file to .env and set real values. .env is gitignored and never committed.
# docker-compose.yml and the backend (npm run dev) both read .env.

# PostgreSQL login and database. Postgres uses them only when it first creates an empty
# data volume; changing them later does not change an existing database.
POSTGRES_USER=truck_api
POSTGRES_PASSWORD=change-me
POSTGRES_DB=truck_entry

# Port on this machine (localhost only) for the backend and tests. Change it if 5432 is in use.
POSTGRES_PORT=5432

# The app sends this in the x-api-key header. At least 16 characters; use a long random one on a server.
API_KEY=dev-api-key-change-me

# Where `docker compose up` publishes the API. 127.0.0.1 = this machine only;
# 0.0.0.0 = also reachable from a phone on the same Wi-Fi.
API_BIND=127.0.0.1
API_PORT=3000
