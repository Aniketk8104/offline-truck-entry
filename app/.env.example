# Copy to app/.env when running the app with `npx expo start` (Expo Go or a development build).
# The APK gets these values from EAS environment variables instead (app/.env is gitignored, so
# EAS Build never sees it).
# Phone and laptop on the same Wi-Fi: use the laptop's address and set API_BIND=0.0.0.0 in the root .env.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_API_KEY=dev-api-key-change-me
