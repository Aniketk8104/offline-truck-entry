# The company's assignment brief: kept locally, never committed to the public repo
assignment/
# Private working files: plan, progress log, Kiro steering (not part of the deliverable)
notes/
.kiro/

# Secrets: real env files stay on each machine; only the .env.example templates are committed
.env
.env.*
!.env.example

# Android signing keys and EAS credentials
*.jks
*.keystore
credentials.json

# Build output: the APK is published on GitHub Releases, not stored in git
*.apk
*.aab
dist/

# Truck photos uploaded to the API: runtime data, not source code
uploads/

# Installed packages, test coverage, Expo cache and logs (all regenerated by the tools)
node_modules/
coverage/
.expo/
*.log
